# ==== AI FRIENDS — variáveis de ambiente ====
# Copie este arquivo para .env.local e preencha.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# SECRETA: nunca exponha no frontend. Usada só no servidor.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# SECRETA: chave mestra usada para criptografar (AES-256-GCM) as chaves de API dos usuários.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Se você trocar esta chave, as chaves de API salvas deixam de funcionar (cada usuário terá que cadastrar de novo).
ENCRYPTION_KEY=cole-aqui-32-bytes-em-base64

# Opcional: domínio dos e-mails internos (login é só por usuário + senha; nenhum e-mail é enviado).
AUTH_EMAIL_DOMAIN=users.aifriends.local
